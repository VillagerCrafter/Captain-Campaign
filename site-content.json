    "element-35-p": {
      "styles": {
        "left": 0,
        "top": -8
      },
      "text": "Too many brands struggle to engage potential customers. Whether through digital ads or in-person campaigns, marketing often feels disconnected from the people it’s meant to reach, and customers aren’t given a big enough reason to stop, interact, and care."
    },
