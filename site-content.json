    "service-slot-1-title": {
      "styles": {},
      "text": "Brand Activations & Ambassadors"
    },
    "service-slot-1-button": {
      "styles": {},
      "serviceDescription": "From the first guest interaction to the last photo of the day, I help bring brand activations to life with confident ambassador representation, audience engagement, and practical on-site support.",
      "serviceExample": "During the Tamagotchi Tour, I sold over $3,000 in $3 Tamagotchi Gashapon tokens in under 6 hours. For the Lynne Experience, I ran Cub Foods sampling events solo, handling setup, teardown, and sales.",
      "serviceImage": "/uploads/7ce47df90f3a18bdc1b8eb70cfa2051f.jpg"
    },
    "admin-toolbar-resize": {
      "styles": {
        "left": 290,
        "top": -22
      }
    },
    "service-slot-2-image": {
      "styles": {}
    },
    "service-slot-2-button": {
      "styles": {},
      "serviceExample": "On Samson’s Grapes’ Midwest tour, I set up activations at Walmart locations across multiple states. I issued over 1,000 grape coupons and used guerrilla marketing in-store to drive hundreds of grape sales each stop."
    },
    "service-slot-3-title": {
      "styles": {
        "left": 0,
        "top": 0
      },
      "text": "Hosting & Emceeing"
    },
    "service-slot-3-button": {
      "styles": {}
    },
    "service-slot-4-title": {
      "styles": {},
      "text": "Content & Social Media"
    },
    "service-slot-4-button": {
      "styles": {},
      "serviceDescription": "I film and photograph activations, then edit the footage into promotional content that I post online and hand to brand marketing teams, allowing digital audiences beyond the activation's floors to experience the magic of the event and connect with the brand.",
      "serviceExample": "My event footage and brand performances have been featured on television by KARE 11 (Nightmare Bar) and WAVE (Sargento Cheese Wheeler Tour), putting both activations in front of thousands of viewers and driving higher attendance.",
      "serviceImage": "/uploads/1039d61d7c1e5bbedb3610019a575d57.jpg"
    },
